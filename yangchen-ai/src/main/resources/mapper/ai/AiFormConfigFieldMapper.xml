<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangchen.ai.mapper.AiFormConfigFieldMapper">
    <!-- 单表 CRUD 及批量新增/修改由 MyBatis-Plus BaseMapper 处理（批量在 Service 层按主键区分后逐条 BATCH 执行），此处仅保留 resultMap 映射及主子表外键 SQL -->

    <resultMap type="AiFormConfigField" id="AiFormConfigFieldResult">
        <id property="id" column="id"/>
        <result property="formId" column="form_id"/>
        <result property="fieldName" column="field_name"/>
        <result property="fieldLabel" column="field_label"/>
        <result property="fieldType" column="field_type"/>
        <result property="requiredFlag" column="required_flag"/>
        <result property="defaultValue" column="default_value"/>
        <result property="optionSource" column="option_source"/>
        <result property="dictType" column="dict_type"/>
        <result property="optionTool" column="option_tool"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
</mapper>
