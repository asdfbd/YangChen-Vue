<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangchen.ai.mapper.AiChatTitleMapper">
    <!-- 单表 CRUD 及批量新增/修改由 MyBatis-Plus BaseMapper 处理（批量在 Service 层按主键区分后逐条 BATCH 执行），此处仅保留 resultMap 映射及主子表外键 SQL -->

    <resultMap type="AiChatTitle" id="AiChatTitleResult">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="title" column="title"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
</mapper>
