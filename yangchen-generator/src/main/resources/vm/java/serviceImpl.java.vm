    /**
     * 批量新增或修改${functionName}（主键存在则修改，不存在则新增；ExecutorType.BATCH 分批执行）
     *
     * @param list ${functionName}列表
     * @return 结果
     */
    @Override
    public int batchInsertOrUpdate(List<${ClassName}> list) {
        if (CollUtil.isEmpty(list)) {
            return 0;
        }
        Date now = DateUtils.getNowDate();
        SqlSessionFactory sqlSessionFactory = SqlHelper.sqlSessionFactory(${ClassName}. class);
        int batchSize = 1000;
        try (SqlSession session = sqlSessionFactory.openSession(ExecutorType.BATCH)) {
                ${ClassName}Mapper batchMapper = session.getMapper(${ClassName}Mapper.class);
            for (int i = 0; i < list.size(); i++) {
                ${ClassName} item = list.get(i);
                if (item.get${pkColumn.capJavaField}() != null && batchMapper.selectById(item.get${pkColumn.capJavaField}()) != null) {
                    item.setUpdateTime(now);
                    batchMapper.updateById(item);
                } else {
                    item.setCreateTime(now);
                    item.setUpdateTime(now);
                    batchMapper.insert(item);
                }
                if ((i + 1) % batchSize == 0) {
                    session.flushStatements();
                }
            }
            session.flushStatements();
        }
        return list.size();
    }
